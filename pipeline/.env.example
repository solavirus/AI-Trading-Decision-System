# Copy to .env and fill in what you have. Everything here is optional — sources without a key
# run in 'stub' status and say so in the report, they don't silently fail.

# Macro (CPI, Fed funds rate). Free self-serve signup, instant approval:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# On-chain ETH half (BTC half via mempool.space needs no key). Free self-serve signup:
# https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Liquidation data. No free tier confirmed — check current pricing before signing up:
# https://www.coinglass.com/pricing
COINGLASS_API_KEY=

# Farside Investors' page is behind a Cloudflare bot challenge (confirmed 2026-08-05) — ruled
# out deliberately rather than defeating it. ETF flow instead comes from our own SQLite snapshot
# DB (see README "ETF 资金流数据库") plus this:

# Xoomar (xoomar.com/developers) — free, works keyless at 30 req/min/IP; a key raises that to
# 120 req/min. Used for: economic calendar (sources/macro.ts) and supplementary ETF flow tickers
# (sources/etf.ts). Its liquidations endpoint returned an implausible number during evaluation —
# deliberately NOT used anywhere; don't wire it in without re-validating against a known-good
# reference first.
XOOMAR_API_KEY=

# AI Engine (Sprint 3.1B, pipeline/src/ai/). Each is optional independently — a provider with no
# key here simply reports "provider_not_configured" via POST /api/ai/analyze rather than failing
# the whole endpoint. Keys live ONLY here (backend env) — never sent to or stored by the frontend.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=

# Sprint 3.1C-prep: configurable base URLs for the 4 providers above, so a third-party relay/
# gateway exposing the SAME request/response shape as the official API can be used instead.
# Leave blank to use the official endpoint (this is the default, safe to ignore if you're using
# the real providers directly). Each is independent of the others.
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
GOOGLE_AI_BASE_URL=
DEEPSEEK_BASE_URL=

# Generic OpenAI-compatible relay/gateway — a 5th, separate provider ("openai-compatible"), for
# relays that don't correspond to any of the 4 official providers above. BOTH must be set (unlike
# the 4 above, there is no official-endpoint fallback for a generic relay) or this provider
# reports not-configured. Model name is whatever you send in the request — not fixed here.
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=

# Optional — backend timeout for one AI provider request, in milliseconds. Defaults to 120000 if unset.
AI_REQUEST_TIMEOUT_MS=
